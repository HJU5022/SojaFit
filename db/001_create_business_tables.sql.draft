-- DRAFT ONLY: Migration 1 business schema, excluding corpus tables owned by PR #17.
-- This file is intentionally named *.sql.draft and is not run by Docker init or a migration runner.
-- Do not apply until db/ERD.md is approved and the migration runner/history convention is selected.
-- Draft choices requiring review:
--   * BIGINT primary keys use GENERATED BY DEFAULT AS IDENTITY.
--   * updated_at is initialized on insert; the application must update it on later writes.
--   * Optional constraints marked as assumptions in the definition are included below and need owner review.
-- Requires PR #17 db/02_rag_corpus.sql first: source_documents, document_chunks, and their indexes.
-- The 001 draft name does not establish a safe execution order; decide the migration sequence before activation.

CREATE TABLE users (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY,
    login_id VARCHAR(100) NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    display_name VARCHAR(100),
    is_active BOOLEAN NOT NULL DEFAULT TRUE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT pk_users PRIMARY KEY (id),
    CONSTRAINT uq_users_login_id UNIQUE (login_id)
);

CREATE TABLE circuits (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY,
    user_id BIGINT NOT NULL,
    name VARCHAR(200) NOT NULL,
    original_filename VARCHAR(255) NOT NULL,
    netlist_format VARCHAR(50) NOT NULL,
    netlist_content TEXT NOT NULL,
    content_sha256 CHAR(64) NOT NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT pk_circuits PRIMARY KEY (id),
    CONSTRAINT fk_circuits_user FOREIGN KEY (user_id) REFERENCES users (id) ON DELETE RESTRICT,
    CONSTRAINT ck_circuits_netlist_format CHECK (netlist_format = 'KICAD_NET')
);
CREATE INDEX ix_circuits_content_sha256 ON circuits (content_sha256);

CREATE TABLE parts (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY,
    manufacturer VARCHAR(150) NOT NULL,
    part_number VARCHAR(150) NOT NULL,
    category_code VARCHAR(50) NOT NULL,
    package_code VARCHAR(100),
    description TEXT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT pk_parts PRIMARY KEY (id),
    CONSTRAINT ck_parts_category_code CHECK (category_code IN (
        'RECTIFIER', 'SCHOTTKY', 'ZENER', 'TVS', 'ESD', 'SWITCHING', 'SIC_SCHOTTKY'
    )),
    -- Definition §5.3/§7 marks this combination as a candidate/assumption; confirm before applying.
    CONSTRAINT uq_parts_manufacturer_part_number UNIQUE (manufacturer, part_number)
);


CREATE TABLE part_documents (
    part_id BIGINT NOT NULL,
    document_id BIGINT NOT NULL,
    relationship_type VARCHAR(30) NOT NULL,
    is_primary BOOLEAN NOT NULL DEFAULT FALSE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT pk_part_documents PRIMARY KEY (part_id, document_id),
    CONSTRAINT fk_part_documents_part FOREIGN KEY (part_id) REFERENCES parts (id) ON DELETE RESTRICT,
    CONSTRAINT fk_part_documents_document FOREIGN KEY (document_id) REFERENCES source_documents (id) ON DELETE RESTRICT
);


CREATE TABLE part_specifications (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY,
    part_id BIGINT NOT NULL,
    document_id BIGINT NOT NULL,
    parameter_code VARCHAR(100) NOT NULL,
    symbol VARCHAR(50),
    minimum_value NUMERIC,
    typical_value NUMERIC,
    maximum_value NUMERIC,
    text_value TEXT,
    source_value_text TEXT NOT NULL,
    source_unit VARCHAR(30),
    normalized_unit VARCHAR(30),
    test_condition TEXT,
    page_number INTEGER,
    table_name VARCHAR(500),
    row_label VARCHAR(500),
    footnote_text TEXT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT pk_part_specifications PRIMARY KEY (id),
    CONSTRAINT fk_part_specifications_part FOREIGN KEY (part_id) REFERENCES parts (id) ON DELETE RESTRICT,
    CONSTRAINT fk_part_specifications_document FOREIGN KEY (document_id) REFERENCES source_documents (id) ON DELETE RESTRICT,
    CONSTRAINT ck_part_specifications_parameter_code CHECK (parameter_code IN (
        'VRRM', 'IF_AV', 'IFSM', 'VF', 'IR', 'TRR', 'VZ', 'PD', 'CJ', 'TJ_MAX'
    )),
    CONSTRAINT ck_part_specifications_normalized_unit CHECK (
        normalized_unit IS NULL OR normalized_unit IN ('V', 'A', 's', 'W', 'F', 'degC')
    ),
    -- Marked as an assumption in the definition; confirm parser needs before applying.
    CONSTRAINT ck_part_specifications_has_value CHECK (
        minimum_value IS NOT NULL OR typical_value IS NOT NULL OR maximum_value IS NOT NULL OR text_value IS NOT NULL
    )
);

CREATE TABLE analysis_runs (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY,
    user_id BIGINT NOT NULL,
    circuit_id BIGINT NOT NULL,
    thread_id VARCHAR(200) NOT NULL,
    original_part_id BIGINT,
    target_reference VARCHAR(100) NOT NULL,
    role_code VARCHAR(100),
    role_description TEXT,
    status_code VARCHAR(30) NOT NULL,
    corpus_version VARCHAR(100) NOT NULL,
    rule_version VARCHAR(100) NOT NULL,
    model_name VARCHAR(200) NOT NULL,
    prompt_version VARCHAR(100) NOT NULL,
    trace_id VARCHAR(200),
    started_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    completed_at TIMESTAMPTZ,
    failure_reason TEXT,
    CONSTRAINT pk_analysis_runs PRIMARY KEY (id),
    CONSTRAINT uq_analysis_runs_thread_id UNIQUE (thread_id),
    CONSTRAINT fk_analysis_runs_user FOREIGN KEY (user_id) REFERENCES users (id) ON DELETE RESTRICT,
    CONSTRAINT fk_analysis_runs_circuit FOREIGN KEY (circuit_id) REFERENCES circuits (id) ON DELETE RESTRICT,
    CONSTRAINT fk_analysis_runs_original_part FOREIGN KEY (original_part_id) REFERENCES parts (id) ON DELETE RESTRICT,
    CONSTRAINT ck_analysis_runs_role_code CHECK (role_code IS NULL OR role_code IN (
        'REVERSE_POLARITY', 'RECTIFICATION', 'FLYBACK', 'CLAMP_ESD', 'ZENER_REFERENCE', 'REVERSE_BLOCKING'
    )),
    CONSTRAINT ck_analysis_runs_status_code CHECK (status_code IN (
        'RUNNING', 'AWAITING_APPROVAL', 'APPROVED', 'REJECTED', 'FAILED'
    ))
);

CREATE TABLE replacement_requirements (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY,
    analysis_run_id BIGINT NOT NULL,
    parameter_code VARCHAR(100) NOT NULL,
    comparison_operator VARCHAR(20) NOT NULL,
    required_value NUMERIC,
    secondary_value NUMERIC,
    required_text TEXT,
    unit VARCHAR(30),
    test_condition TEXT,
    is_mandatory BOOLEAN NOT NULL DEFAULT TRUE,
    rationale TEXT NOT NULL,
    sort_order INTEGER NOT NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT pk_replacement_requirements PRIMARY KEY (id),
    CONSTRAINT fk_replacement_requirements_analysis FOREIGN KEY (analysis_run_id) REFERENCES analysis_runs (id) ON DELETE RESTRICT,
    CONSTRAINT ck_replacement_requirements_parameter_code CHECK (parameter_code IN (
        'VRRM', 'IF_AV', 'IFSM', 'VF', 'IR', 'TRR', 'VZ', 'PD', 'CJ', 'TJ_MAX'
    )),
    CONSTRAINT ck_replacement_requirements_unit CHECK (
        unit IS NULL OR unit IN ('V', 'A', 's', 'W', 'F', 'degC')
    ),
    CONSTRAINT ck_replacement_requirements_sort_order CHECK (sort_order >= 0),
    CONSTRAINT ck_replacement_requirements_value_shape CHECK (
        (comparison_operator = 'BETWEEN' AND required_value IS NOT NULL AND secondary_value IS NOT NULL AND required_text IS NULL)
        OR (comparison_operator = 'IN' AND required_value IS NULL AND secondary_value IS NULL AND required_text IS NOT NULL)
        OR (comparison_operator IN ('>=', '<=') AND required_value IS NOT NULL AND secondary_value IS NULL AND required_text IS NULL)
        OR (comparison_operator = '=' AND secondary_value IS NULL AND (
            (required_value IS NOT NULL AND required_text IS NULL)
            OR (required_value IS NULL AND required_text IS NOT NULL)
        ))
    ),
    CONSTRAINT ck_replacement_requirements_operator CHECK (comparison_operator IN ('>=', '<=', '=', 'BETWEEN', 'IN'))
);

CREATE TABLE candidate_evaluations (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY,
    analysis_run_id BIGINT NOT NULL,
    candidate_part_id BIGINT NOT NULL,
    verdict_code VARCHAR(30) NOT NULL,
    reason TEXT NOT NULL,
    board_change_required BOOLEAN NOT NULL DEFAULT FALSE,
    uncertainty_reason TEXT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT pk_candidate_evaluations PRIMARY KEY (id),
    CONSTRAINT fk_candidate_evaluations_analysis FOREIGN KEY (analysis_run_id) REFERENCES analysis_runs (id) ON DELETE RESTRICT,
    CONSTRAINT fk_candidate_evaluations_part FOREIGN KEY (candidate_part_id) REFERENCES parts (id) ON DELETE RESTRICT,
    CONSTRAINT uq_candidate_evaluations_analysis_candidate UNIQUE (analysis_run_id, candidate_part_id),
    CONSTRAINT ck_candidate_evaluations_verdict CHECK (verdict_code IN (
        'IDENTICAL', 'SPEC_EQUIVALENT', 'ROLE_SUFFICIENT', 'NOT_SUFFICIENT', 'NOT_VERIFIED'
    ))
);

CREATE TABLE requirement_checks (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY,
    candidate_evaluation_id BIGINT NOT NULL,
    requirement_id BIGINT NOT NULL,
    part_specification_id BIGINT,
    result_code VARCHAR(20) NOT NULL,
    unknown_reason_code VARCHAR(30),
    compared_value NUMERIC,
    compared_text TEXT,
    note TEXT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT pk_requirement_checks PRIMARY KEY (id),
    CONSTRAINT fk_requirement_checks_evaluation FOREIGN KEY (candidate_evaluation_id) REFERENCES candidate_evaluations (id) ON DELETE RESTRICT,
    CONSTRAINT fk_requirement_checks_requirement FOREIGN KEY (requirement_id) REFERENCES replacement_requirements (id) ON DELETE RESTRICT,
    CONSTRAINT fk_requirement_checks_specification FOREIGN KEY (part_specification_id) REFERENCES part_specifications (id) ON DELETE RESTRICT,
    CONSTRAINT uq_requirement_checks_evaluation_requirement UNIQUE (candidate_evaluation_id, requirement_id),
    CONSTRAINT ck_requirement_checks_result CHECK (result_code IN ('PASS', 'FAIL', 'UNKNOWN')),
    CONSTRAINT ck_requirement_checks_unknown_reason CHECK (unknown_reason_code IS NULL OR unknown_reason_code IN (
        'VALUE_MISSING', 'CONDITION_MISMATCH', 'DOC_NOT_FOUND'
    )),
    CONSTRAINT ck_requirement_checks_unknown_pair CHECK (
        (result_code = 'UNKNOWN' AND unknown_reason_code IS NOT NULL)
        OR (result_code <> 'UNKNOWN' AND unknown_reason_code IS NULL)
    )
);

CREATE TABLE evidence_citations (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY,
    candidate_evaluation_id BIGINT NOT NULL,
    document_id BIGINT NOT NULL,
    chunk_id BIGINT,
    requirement_check_id BIGINT,
    citation_type VARCHAR(30) NOT NULL,
    page_number INTEGER,
    section_name VARCHAR(500),
    table_name VARCHAR(500),
    row_label VARCHAR(500),
    quoted_text TEXT NOT NULL,
    sort_order INTEGER NOT NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT pk_evidence_citations PRIMARY KEY (id),
    CONSTRAINT fk_evidence_citations_evaluation FOREIGN KEY (candidate_evaluation_id) REFERENCES candidate_evaluations (id) ON DELETE RESTRICT,
    CONSTRAINT fk_evidence_citations_document FOREIGN KEY (document_id) REFERENCES source_documents (id) ON DELETE RESTRICT,
    CONSTRAINT fk_evidence_citations_chunk FOREIGN KEY (chunk_id) REFERENCES document_chunks (id) ON DELETE RESTRICT,
    CONSTRAINT fk_evidence_citations_requirement_check FOREIGN KEY (requirement_check_id) REFERENCES requirement_checks (id) ON DELETE RESTRICT,
    CONSTRAINT ck_evidence_citations_sort_order CHECK (sort_order >= 0)
);

CREATE TABLE quotes (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY,
    analysis_run_id BIGINT NOT NULL,
    quote_number VARCHAR(100) NOT NULL,
    approved_by_user_id BIGINT NOT NULL,
    currency_code CHAR(3) NOT NULL,
    total_amount NUMERIC(18,4) NOT NULL,
    approved_at TIMESTAMPTZ NOT NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT pk_quotes PRIMARY KEY (id),
    CONSTRAINT uq_quotes_analysis_run UNIQUE (analysis_run_id),
    CONSTRAINT uq_quotes_quote_number UNIQUE (quote_number),
    CONSTRAINT fk_quotes_analysis FOREIGN KEY (analysis_run_id) REFERENCES analysis_runs (id) ON DELETE RESTRICT,
    CONSTRAINT fk_quotes_approver FOREIGN KEY (approved_by_user_id) REFERENCES users (id) ON DELETE RESTRICT,
    CONSTRAINT ck_quotes_total_amount CHECK (total_amount >= 0)
);

CREATE TABLE quote_items (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY,
    quote_id BIGINT NOT NULL,
    candidate_evaluation_id BIGINT NOT NULL,
    quantity INTEGER NOT NULL,
    unit_price NUMERIC(18,4) NOT NULL,
    line_amount NUMERIC(18,4) NOT NULL,
    price_source VARCHAR(200) NOT NULL,
    price_as_of TIMESTAMPTZ,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT pk_quote_items PRIMARY KEY (id),
    CONSTRAINT fk_quote_items_quote FOREIGN KEY (quote_id) REFERENCES quotes (id) ON DELETE RESTRICT,
    CONSTRAINT fk_quote_items_evaluation FOREIGN KEY (candidate_evaluation_id) REFERENCES candidate_evaluations (id) ON DELETE RESTRICT,
    CONSTRAINT ck_quote_items_quantity CHECK (quantity >= 1),
    CONSTRAINT ck_quote_items_unit_price CHECK (unit_price >= 0),
    CONSTRAINT ck_quote_items_line_amount CHECK (line_amount >= 0)
);

-- Application-level rules from the definition remain outside this schema draft:
-- * quote_items candidate verdict must be eligible and belong to the quote's analysis_run.
-- * requirement_checks requirement must belong to the candidate evaluation's analysis_run.
-- * evidence_citations.chunk_id, when set, must belong to the same document_id.